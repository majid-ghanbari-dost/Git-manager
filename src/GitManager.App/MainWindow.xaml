<Window x:Class="GitManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git Manager" Height="760" Width="1180" MinHeight="600" MinWidth="900" WindowStyle="None" ResizeMode="CanResize"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" FlowDirection="LeftToRight" Background="#E9EEF5" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="16,0">
                <Image Source="{StaticResource GitManagerLogo}" Width="25" Height="25" Margin="0,0,9,0"/>
                <TextBlock Text="Git Manager" Foreground="#000000" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight">
                <ComboBox x:Name="ThemeSelector" Width="118" Height="28" Margin="0,8,10,8" SelectedIndex="0" SelectionChanged="ThemeSelector_SelectionChanged">
                    <ComboBoxItem Content="سیستم"/>
                    <ComboBoxItem Content="روشن"/>
                    <ComboBoxItem Content="تاریک"/>
                </ComboBox>
                <Button Content="—" Width="42" Margin="0" Padding="0" Background="Transparent" Foreground="#000000" BorderThickness="0" Click="Minimize_Click"/>
                <Button Content="□" Width="42" Margin="0" Padding="0" Background="Transparent" Foreground="#000000" BorderThickness="0" Click="Maximize_Click"/>
                <Button Content="×" Width="46" Margin="0" Padding="0" Background="#F5DDE1" Foreground="#000000" BorderThickness="0" Click="Close_Click"/>
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="1" Margin="22,18,22,18">
            <StackPanel>
                <TextBlock Text="مدیریت پروژه‌های Git" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="کتابخانه‌ای منظم؛ هر پروژه در فضای مستقل خودش" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Left" Content="تغییر محل کتابخانه" Command="{Binding ChangeWorkspaceCommand}" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="محل کتابخانه" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding WorkspacePath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ProjectCount, StringFormat={}{0} پروژه}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#000000"/>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="22,0,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="16">
                <StackPanel>
                    <TextBlock Text="دریافت پروژه از GitHub" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="نشانی HTTPS مخزن را وارد کنید؛ نمونه:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="https://github.com/owner/repository" FlowDirection="LeftToRight" TextAlignment="Left" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,3,0,8"/>
                    <TextBlock Text="نشانی مخزن" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox Text="{Binding RepositoryUrl, UpdateSourceTrigger=PropertyChanged}" Padding="9" Margin="0,5,0,12" FlowDirection="LeftToRight"/>
                    <TextBlock Text="دسته‌بندی مقصد" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Padding="7" Margin="0,5,0,12"/>
                    <Button Content="Clone و افزودن به کتابخانه" Command="{Binding CloneCommand}" ToolTip="{Binding CloneDisabledReason}" Background="#DCE8F7" Foreground="#000000" BorderThickness="0" Padding="10,9"/>
                    <TextBlock Text="مسیر ذخیره‌سازی: کتابخانه ← 01_Active ← دسته‌بندی ← مالک ← نام مخزن" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,7,2,0"/>
                    <TextBlock Text="برای مخزن خصوصی، احراز هویت Git Credential Manager ویندوز استفاده می‌شود؛ رمز یا توکن در برنامه ذخیره نمی‌شود." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,5,2,0"/>
                    <TextBlock Text="{Binding CloneDisabledReason}" Foreground="#000000" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Separator Margin="0,18,0,12"/>
                    <TextBlock Text="مدیریت دسته‌بندی‌ها" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="دسته‌بندی جدید" Foreground="#000000"/>
                    <DockPanel Margin="0,4,0,10">
                        <Button DockPanel.Dock="Left" Content="ایجاد" Command="{Binding CreateCategoryCommand}" Padding="12,5"/>
                        <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Padding="7" FlowDirection="RightToLeft"/>
                    </DockPanel>
                    <TextBlock Text="تغییر نام دسته‌بندی انتخاب‌شده" Foreground="#000000"/>
                    <DockPanel Margin="0,4,0,8">
                        <Button DockPanel.Dock="Left" Content="تغییر نام" Command="{Binding RenameCategoryCommand}" Padding="10,5"/>
                        <TextBox Text="{Binding RenameCategoryName, UpdateSourceTrigger=PropertyChanged}" Padding="7"/>
                    </DockPanel>
                    <Button Content="حذف دسته خالی انتخاب‌شده" Command="{Binding DeleteCategoryCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="بالا بردن دسته" Command="{Binding MoveCategoryUpCommand}" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="پایین بردن دسته" Command="{Binding MoveCategoryDownCommand}" Padding="10,5"/>
                    </StackPanel>
                    <TextBlock Text="تغییر نام دسته دارای پروژه، همه پوشه‌های پروژه را با ثبت Journal و امکان بازیابی منتقل می‌کند. حذف دسته دارای پروژه مجاز نیست؛ ابتدا پروژه‌ها را جداگانه منتقل کنید. Unclassified همیشه در ابتدای فهرست می‌ماند." TextWrapping="Wrap" Foreground="#000000" FontSize="11" Margin="4,0,4,0"/>
                    <TextBlock Text="Clone فقط فایل‌ها و تاریخچه مخزن را دریافت می‌کند؛ هیچ اسکریپت یا کد پروژه‌ای به‌صورت خودکار اجرا نمی‌شود." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="4,10,4,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="پروژه‌های کتابخانه" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="ارسال به GitHub" Command="{Binding PushCommand}" ToolTip="ارسال Commitهای شاخه فعلی به origin با Git Credential Manager؛ بدون Force Push" Margin="16,0,0,0" Padding="12,5"/>
                            <Button Content="پشتیبان‌گیری + SHA-256" Command="{Binding BackupCommand}" Margin="16,0,0,0" Padding="12,5"/>
                            <Button Content="انتقال پروژه به دسته انتخاب‌شده" Command="{Binding MoveProjectCommand}" Margin="8,0,0,0" Padding="12,5"/>
                            <Button Content="بازیابی پشتیبان" Command="{Binding RestoreCommand}" Margin="8,0,0,0" Padding="12,5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="فیلتر وضعیت" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding LifecycleFilters}" SelectedItem="{Binding SelectedLifecycleFilter}" Width="140" Padding="6"/>
                            <TextBlock Text="جست‌وجو" VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="6"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" Width="230" Padding="6" ToolTip="پیام Commit؛ تمام تغییرات محلی پس از تأیید Stage می‌شوند" />
                            <Button Content="Commit محلی" Command="{Binding CommitCommand}" Padding="10,5"/>
                            <Button Content="Fetch" Command="{Binding FetchCommand}" Padding="10,5"/>
                            <Button Content="Pull امن" Command="{Binding PullCommand}" Padding="10,5" ToolTip="فقط Fast-Forward؛ مخزن باید تغییرات Commit‌نشده نداشته باشد"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="انتقال به فعال" Command="{Binding MoveToActiveCommand}" Padding="10,5" Margin="0,0,6,0"/>
                            <Button Content="انتقال به معلق" Command="{Binding MoveToOnHoldCommand}" Padding="10,5" Margin="0,0,6,0"/>
                            <Button Content="بایگانی پروژه" Command="{Binding ArchiveProjectCommand}" Padding="10,5" Margin="0,0,6,0"/>
                            <Button Content="بازگردانی از بایگانی" Command="{Binding RestoreArchivedCommand}" Padding="10,5"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              FlowDirection="RightToLeft" RowHeight="38" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="پروژه" Binding="{Binding Repository}" Width="*"/>
                            <DataGridTextColumn Header="مالک" Binding="{Binding Owner}" Width="120"/>
                            <DataGridTextColumn Header="دسته" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding Lifecycle}" Width="80"/>
                            <DataGridTextColumn Header="دسترسی" Binding="{Binding AvailabilityDisplay}" Width="90"/>
                            <DataGridTextColumn Header="شاخه" Binding="{Binding CurrentBranch}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="4" Background="Transparent" Padding="26,12,26,12">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#000000" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>

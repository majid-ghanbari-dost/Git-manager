<Window x:Class="GitManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git Manager" Height="720" Width="1120" MinHeight="560" MinWidth="850"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="مدیریت پروژه‌های Git" FontSize="27" FontWeight="Bold" Foreground="#203247"/>
                <TextBlock Text="کتابخانه‌ای منظم؛ هر پروژه در فضای مستقل خودش" Foreground="#66788A" Margin="0,5,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Left" Content="تغییر محل کتابخانه" Command="{Binding ChangeWorkspaceCommand}" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="9" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="محل کتابخانه" Foreground="#718096" FontSize="12"/>
                    <TextBlock Text="{Binding WorkspacePath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ProjectCount, StringFormat={}{0} پروژه}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#315C8C"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="9" Padding="16">
                <StackPanel>
                    <TextBlock Text="افزودن مخزن GitHub" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>
                    <TextBlock Text="نشانی مخزن" Foreground="#526273"/>
                    <TextBox Text="{Binding RepositoryUrl, UpdateSourceTrigger=PropertyChanged}" Padding="9" Margin="0,5,0,12" FlowDirection="LeftToRight"/>
                    <TextBlock Text="دسته‌بندی" Foreground="#526273"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Padding="7" Margin="0,5,0,12"/>
                    <Button Content="دریافت و ثبت پروژه" Command="{Binding CloneCommand}" Background="#315C8C" Foreground="White" BorderThickness="0"/>
                    <Separator Margin="0,18,0,12"/>
                    <TextBlock Text="مدیریت دسته‌بندی‌ها" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="دسته‌بندی جدید" Foreground="#526273"/>
                    <DockPanel Margin="0,4,0,10">
                        <Button DockPanel.Dock="Left" Content="ایجاد" Command="{Binding CreateCategoryCommand}" Padding="12,5"/>
                        <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Padding="7" FlowDirection="RightToLeft"/>
                    </DockPanel>
                    <TextBlock Text="تغییر نام دسته خالی" Foreground="#526273"/>
                    <DockPanel Margin="0,4,0,8">
                        <Button DockPanel.Dock="Left" Content="تغییر نام" Command="{Binding RenameCategoryCommand}" Padding="10,5"/>
                        <TextBox Text="{Binding RenameCategoryName, UpdateSourceTrigger=PropertyChanged}" Padding="7"/>
                    </DockPanel>
                    <Button Content="حذف دسته خالی انتخاب‌شده" Command="{Binding DeleteCategoryCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                    <TextBlock Text="حذف یا تغییر نام دسته دارای پروژه فعلاً مسدود است تا انتقال فیزیکی و بازیابی امن آن تکمیل شود. هیچ پروژه‌ای خودکار حذف نمی‌شود." TextWrapping="Wrap" Foreground="#9A5B20" FontSize="11" Margin="4,0,4,0"/>
                    <TextBlock Text="مخزن فقط دریافت می‌شود؛ هیچ اسکریپت یا کد پروژه‌ای به‌صورت خودکار اجرا نخواهد شد." TextWrapping="Wrap" Foreground="#788797" FontSize="12" Margin="4,10,4,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="9" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="پروژه‌های کتابخانه" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="پشتیبان‌گیری + SHA-256" Command="{Binding BackupCommand}" Margin="16,0,0,0" Padding="12,5"/>
                        <Button Content="بازیابی پشتیبان" Command="{Binding RestoreCommand}" Margin="8,0,0,0" Padding="12,5"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              FlowDirection="RightToLeft" RowHeight="38" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="پروژه" Binding="{Binding Repository}" Width="*"/>
                            <DataGridTextColumn Header="مالک" Binding="{Binding Owner}" Width="150"/>
                            <DataGridTextColumn Header="دسته" Binding="{Binding Category}" Width="110"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding Lifecycle}" Width="90"/>
                            <DataGridTextColumn Header="شاخه" Binding="{Binding CurrentBranch}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="Transparent" Padding="4,12,4,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#526273" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>

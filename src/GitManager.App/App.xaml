<Application x:Class="GitManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#203247" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#66788A" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#203247" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#E3E8EF" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
  </Application.Resources>
</Application>
